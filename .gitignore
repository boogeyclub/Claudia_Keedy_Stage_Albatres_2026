# ---------------------------------------------------------------------------
# Albatres Stage 2026 - repository-wide ignore rules.
#
# Layout:
#   ANALYSE/                                        modelling / impact-analysis deliverables
#   DEVELOPPEMENT/Back-End/service-connectmarket/   Spring Boot API
#   DEVELOPPEMENT/Back-End/database/                tracked PostgreSQL schema
#   DEVELOPPEMENT/Front-End/                         Angular front end
#   RAPPORT/                                        internship report
#
# Component-specific rules also live next to each project and are honored by Git:
#   DEVELOPPEMENT/.gitignore
#   DEVELOPPEMENT/Front-End/                        Angular front end
#   DEVELOPPEMENT/Back-End/service-connectmarket/   Spring Boot API
# ---------------------------------------------------------------------------

# --- Environment & secrets -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
secrets.*

# Local/overriding Spring profiles (keep application.properties tracked)
application-local.*
application-dev-local.*
application-prod.properties
application-prod.yml
application-prod.yaml
application-secret.*

# --- Logs & temporary files ------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.bak
*.orig
*~

# Microsoft Office / Word lock files (e.g. ~$report.docx)
~$*

# --- Node / Angular --------------------------------------------------------
node_modules/
dist/
tmp/
out-tsc/
bazel-out/
.angular/
.sass-cache/
coverage/
.nyc_output/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Java / Maven ----------------------------------------------------------
target/
build/
out/
*.class
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
.mtj.tmp/
.mvn/wrapper/maven-wrapper.jar

# --- IDEs & editors --------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.apt_generated
.factorypath
.springBeans
.sts4-cache
.vs/
*.suo
*.user
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/
*.swp
*.swo

# --- OS --------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
