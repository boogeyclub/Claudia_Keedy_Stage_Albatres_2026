# Copy this file to src/main/resources/.env, next to application.properties.
# PostgreSQL must already be running and contain the configured database/user.
# These values are for local development only; use secure deployment-specific credentials elsewhere.
# This local .env file is ignored by Git and excluded from the packaged WAR.
POSTGRES_HOST=localhost
POSTGRES_PORT=6000
POSTGRES_DB=cacaomarketcm
POSTGRES_USER=sorelle
POSTGRES_PASSWORD=root1234

# The API is served at /cacaomarketcm/api by default. Set this only when a deployment must
# override the default Spring servlet context; update the Angular API base URL at the same time.
SERVER_SERVLET_CONTEXT_PATH=/cacaomarketcm

# Google Gmail SMTP configuration for account-confirmation and password-reset emails.
# 1. Enable 2-Step Verification on the Google account that will send CacaoMarketCM mail.
# 2. Create a Google App Password at https://myaccount.google.com/apppasswords.
# 3. Paste the generated 16-character App Password below (not the normal Google account password).
# Keep these values only in the untracked local .env file; never commit real credentials.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-google-address@gmail.com
MAIL_PASSWORD=replace-with-your-google-app-password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_TIMEOUT=10000
MAIL_SMTP_WRITE_TIMEOUT=10000
# Use the same Google mailbox or a sender alias that Google has verified for this account.
# Leave blank to use MAIL_USERNAME automatically.
REGISTRATION_MAIL_FROM=

# Public Angular confirmation page placed in the confirmation email. Append no token;
# the service adds the secure token query parameter itself and the Angular page sends it to the API.
# In production, replace localhost with your public frontend host/domain.
REGISTRATION_CONFIRMATION_URL=http://localhost:4200/CacaoMarketCM/registration/confirm

# Public Angular page used for single-use password-reset links. Do not append a token here.
PASSWORD_RESET_URL=http://localhost:4200/CacaoMarketCM/password-reset/confirm
# ISO-8601 token lifetime; PT1H means one hour.
PASSWORD_RESET_TOKEN_TTL=PT1H

# Comma-separated browser origins permitted to call the API directly.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Optional: how frequently expired persistent browser-session records are marked invalid.
SESSION_CLEANUP_INTERVAL=PT5M
